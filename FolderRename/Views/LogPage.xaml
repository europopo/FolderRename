<Page
    x:Class="FolderRename.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="32" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="执行日志" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="成功、失败与重试记录会保存在本机。" Opacity="0.7" /></StackPanel>
            <Button Grid.Column="1" Content="清空日志" Click="Clear_Click" VerticalAlignment="Center" />
        </Grid>
        <ListView Grid.Row="1" ItemsSource="{Binding}" SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate><Grid Padding="12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Level}" /><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
            </Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
