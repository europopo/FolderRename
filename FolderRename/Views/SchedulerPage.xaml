<Page
    x:Class="FolderRename.Views.SchedulerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="文件夹定时更名" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="按日期自动更新本地文件夹名称。计划会在应用运行期间持续监控。" Opacity="0.7" />
            </StackPanel>
            <InfoBar IsOpen="True" Severity="Informational" Title="更名规则" Message="文件夹将改为“前缀 + 日期”产生的名称，例如 Reports20260903。请确保同级目录中没有同名文件夹。" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="1. 目标与命名规则" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Header="本地文件夹路径" PlaceholderText="例如 C:\Reports\Current" Text="{Binding FolderPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="Browse_Click" />
                    </Grid>
                    <TextBox Header="重命名前缀" PlaceholderText="默认使用所选文件夹名称" Text="{Binding RenamePrefix, Mode=TwoWay}" />
                    <ComboBox Header="按日期命名格式" SelectedValue="{Binding DateFormat, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="20260903（推荐）" Tag="yyyyMMdd" /><ComboBoxItem Content="2026-09-03" Tag="yyyy-MM-dd" /><ComboBoxItem Content="2026年09月03日" Tag="yyyy年MM月dd日" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="2. 执行时间" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="ModeSelector" Header="计划类型" ItemsSource="{Binding ScheduleModes}" SelectedItem="{Binding Mode, Mode=TwoWay}" SelectionChanged="ModeSelector_SelectionChanged" />
                    <StackPanel x:Name="OnceSchedulePanel" Spacing="12">
                        <TextBlock Text="一次执行时间" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <DatePicker x:Name="RunDatePicker" Header="执行日期" DateChanged="RunDatePicker_DateChanged" />
                            <TimePicker x:Name="RunTimePicker" Grid.Column="1" Header="执行时间" TimeChanged="RunTimePicker_TimeChanged" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="RecurringSchedulePanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="周期执行时间" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <RadioButtons x:Name="RecurrenceButtons" Header="重复频率" SelectionChanged="RecurrenceButtons_SelectionChanged">
                            <x:String>每天</x:String><x:String>每周</x:String><x:String>每月</x:String><x:String>每年</x:String>
                        </RadioButtons>
                        <TimePicker x:Name="RecurringTimePicker" Header="执行时间" TimeChanged="RecurringTimePicker_TimeChanged" />
                        <ComboBox x:Name="WeekdaySelector" Header="星期（每周）" SelectionChanged="WeekdaySelector_SelectionChanged" Visibility="Collapsed">
                            <x:String>星期日</x:String><x:String>星期一</x:String><x:String>星期二</x:String><x:String>星期三</x:String><x:String>星期四</x:String><x:String>星期五</x:String><x:String>星期六</x:String>
                        </ComboBox>
                        <NumberBox x:Name="MonthDayBox" Header="日期（每月）" Minimum="1" Maximum="31" SpinButtonPlacementMode="Compact" ValueChanged="MonthDayBox_ValueChanged" Visibility="Collapsed" />
                        <Grid x:Name="YearDatePanel" ColumnSpacing="16" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonthSelector" Header="月份（每年）" SelectionChanged="MonthSelector_SelectionChanged"><x:String>1 月</x:String><x:String>2 月</x:String><x:String>3 月</x:String><x:String>4 月</x:String><x:String>5 月</x:String><x:String>6 月</x:String><x:String>7 月</x:String><x:String>8 月</x:String><x:String>9 月</x:String><x:String>10 月</x:String><x:String>11 月</x:String><x:String>12 月</x:String></ComboBox>
                            <NumberBox x:Name="YearDayBox" Grid.Column="1" Header="日期" Minimum="1" Maximum="31" SpinButtonPlacementMode="Compact" ValueChanged="YearDayBox_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16"><TextBlock Text="3. 失败重试" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <NumberBox Header="重试等待（秒）" Value="{Binding RetryDelaySeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" Header="最多重试次数" Value="{Binding MaxRetries, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="16"><ToggleSwitch Header="启用此计划" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><Button Content="立即执行" Command="{Binding RunNowCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" /><Button Content="保存计划" Click="Save_Click" VerticalAlignment="Bottom" /></StackPanel>
            <InfoBar IsOpen="True" Severity="Success" Title="状态" Message="{Binding StatusText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
