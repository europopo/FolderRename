<Page
    x:Class="FolderRename.Views.SchedulerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="文件夹定时更名" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="按日期自动更新本地文件夹名称。计划会在应用运行期间持续监控。" Opacity="0.7" />
            </StackPanel>
            <InfoBar IsOpen="True" Severity="Informational" Title="更名规则" Message="文件夹将改为日期格式产生的名称，例如 2026-09-03。请确保同级目录中没有同名文件夹。" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="1. 目标与命名规则" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Header="本地文件夹路径" PlaceholderText="例如 C:\Reports\Current" Text="{Binding FolderPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="Browse_Click" />
                    </Grid>
                    <ComboBox Header="按日期命名格式" SelectedValue="{Binding DateFormat, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="2026-09-03（推荐）" Tag="yyyy-MM-dd" /><ComboBoxItem Content="20260903" Tag="yyyyMMdd" /><ComboBoxItem Content="2026年09月03日" Tag="yyyy年MM月dd日" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="2. 执行时间" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox Header="计划类型" ItemsSource="{Binding ScheduleModes}" SelectedItem="{Binding Mode, Mode=TwoWay}" />
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DatePicker x:Name="RunDatePicker" Header="首次执行日期" DateChanged="RunDatePicker_DateChanged" />
                        <TimePicker x:Name="RunTimePicker" Grid.Column="1" Header="首次执行时间" TimeChanged="RunTimePicker_TimeChanged" />
                    </Grid>
                    <NumberBox Header="周期执行间隔（分钟，仅周期计划）" Value="{Binding IntervalMinutes, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16"><TextBlock Text="3. 失败重试" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <NumberBox Header="重试等待（秒）" Value="{Binding RetryDelaySeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" Header="最多重试次数" Value="{Binding MaxRetries, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="16"><ToggleSwitch Header="启用此计划" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><Button Content="立即执行" Command="{Binding RunNowCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" /><Button Content="保存计划" Click="Save_Click" VerticalAlignment="Bottom" /></StackPanel>
            <InfoBar IsOpen="True" Severity="Success" Title="状态" Message="{Binding StatusText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
