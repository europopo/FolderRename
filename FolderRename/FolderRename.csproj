<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FolderRename</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Keep F5/build architecture-neutral. A RuntimeIdentifiers list makes the
      Windows App SDK invoke its native self-contained packaging targets during
      every design-time build. Besides making F5 needlessly slow, those targets
      require a locally installed MSVC toolset and can fail when Visual Studio
      is installed in a different edition/path. Choose a RID only when
      publishing, for example: dotnet publish -r win-x64.
    -->
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
</Project>
