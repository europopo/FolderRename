<Window
    x:Class="FolderRename.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FolderRename.Views"
    Title="Folder Rename">
    <NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="计划设置" Icon="Calendar" Tag="schedule" IsSelected="True" />
            <NavigationViewItem Content="执行日志" Icon="Document" Tag="logs" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
